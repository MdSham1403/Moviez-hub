# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Django migrations
*/migrations/*.py
*/migrations/*.pyc

# SQL database
db.sqlite3
db.sqlite3-journal

# Virtual Environment
env/
venv/

# VS Code settings
.vscode/

# JetBrains IDEs
.idea/

# Environment Variables
.env

# PostgreSQL files
*.log

# Media files (uploaded content)
media/

# Static files (auto-generated by Django's collectstatic command)
staticfiles/

# macOS system files
.DS_Store

# Temporary files
*.bak
*.swp
*.lock
